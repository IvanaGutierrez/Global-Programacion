# Configuración de Base de Datos PostgreSQL (driver asincrónico asyncpg obligatorio)
# Formato: postgresql+asyncpg://usuario:contraseña@host:puerto/nombre_base_datos
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/libreria_db

# Mostrar consultas SQL emitidas en consola para diagnóstico (true/false)
SQL_ECHO=true

# Orígenes CORS permitidos para desarrollo y producción (separados por coma)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://localhost:3000

